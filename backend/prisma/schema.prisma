generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id        String  @id @db.Uuid
  email     String  @unique // Para consultas rápidas desde el backend
  username  String  @unique
  fullName  String? @map("full_name")
  avatarUrl String? @map("avatar_url")
  bio       String?
  wallet    Float   @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  reservations    Reservation[]
  reviewsGiven    Review[]      @relation("ReviewsGiven")
  reviewsReceived Review[]      @relation("ReviewsReceived")

  @@map("profiles")
}

model Resource {
  resourceId  String   @id @default(uuid()) @map("resource_id") @db.Uuid
  name        String
  description String?
  location    String?
  photoUrls   String[] @default([]) @map("photo_urls")
  rules       String[] @default([])
  deposit     Float?
  price       Float    @default(0)
  category    String?
  ownerId     String?  @map("owner_id") @db.Uuid

  isArchived Boolean @default(false) @map("is_archived")

  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  availabilities Availability[]
  reservations   Reservation[]

  @@map("resources")
}

model Availability {
  availabilityId String   @id @default(uuid()) @map("availability_id") @db.Uuid
  resourceId     String   @map("resource_id") @db.Uuid
  dayOfWeek      Int      @map("day_of_week") // 0 = Sunday, 1 = Monday, etc.
  startTime      DateTime @map("start_time") @db.Time
  endTime        DateTime @map("end_time") @db.Time

  resource Resource @relation(fields: [resourceId], references: [resourceId], onDelete: Cascade)

  @@map("availabilities")
}

model Reservation {
  reservationId String   @id @default(uuid()) @map("reservation_id") @db.Uuid
  resourceId    String   @map("resource_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  date          DateTime @db.Date
  startTime     DateTime @map("start_time") @db.Time
  endTime       DateTime @map("end_time") @db.Time

  paymentMethod String @default("WALLET") @map("payment_method")
  total_amount  Float  @default(0) @map("total_amount")
  status        String @default("PENDING") // PENDING, CHECKED_IN, COMPLETED, CANCELLED

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  resource Resource @relation(fields: [resourceId], references: [resourceId], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews  Review[]

  @@map("reservations")
}

model Review {
  id            String   @id @default(uuid()) @map("review_id") @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  reviewerId    String   @map("reviewer_id") @db.Uuid
  targetId      String   @map("target_id") @db.Uuid
  rating        Int
  comment       String?
  imageUrls     String[] @default([]) @map("image_urls")
  role          String // e.g., "TENANT" o "OWNER" (rol del que hace la review)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reservation Reservation @relation(fields: [reservationId], references: [reservationId], onDelete: Cascade)
  reviewer    Profile     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    Profile     @relation("ReviewsReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@map("reviews")
}
