generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id         String   @id @db.Uuid
  email      String   @unique // Para consultas rápidas desde el backend
  username   String   @unique
  full_name  String?
  avatar_url String?
  bio        String?
  wallet     Float    @default(0)

  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@map("profiles")
}

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  category        String?
  photo_url       String?
  virtual_deposit Float?
  rules           String[]
  stock           Int      @default(0)
  is_archived     Boolean  @default(false)
  
  updated_at      DateTime @updatedAt
  created_at      DateTime @default(now())

  @@map("products")
}
