generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model Profile {
  id         String   @id @db.Uuid
  email      String   @unique // Para consultas rápidas desde el backend
  username   String   @unique
  full_name  String?
  avatar_url String?
  bio        String?
  role       Role     @default(USER) // Por defecto todos son USER
  
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  @@map("profiles")
}
