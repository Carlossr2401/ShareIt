generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id         String  @id @db.Uuid
  email      String  @unique // Para consultas rápidas desde el backend
  username   String  @unique
  full_name  String?
  avatar_url String?
  bio        String?
  wallet     Float   @default(0)

  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  reservations Reservation[]

  @@map("profiles")
}


model Resource {
  resource_id String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  location    String?
  photo_url   String?
  rules       String[]
  deposit     Float?
  category    String?

  is_archived Boolean @default(false)

  updated_at DateTime @updatedAt
  created_at DateTime @default(now())

  availabilities Availability[]
  reservations   Reservation[]

  @@map("resources")
}

model Availability {
  availability_id String   @id @default(uuid()) @db.Uuid
  resource_id     String   @db.Uuid
  day_of_week     Int // 0 = Sunday, 1 = Monday, etc.
  start_time      DateTime @db.Time
  end_time        DateTime @db.Time

  resource Resource @relation(fields: [resource_id], references: [resource_id], onDelete: Cascade)

  @@map("availabilities")
}

model Reservation {
  reservation_id String   @id @default(uuid()) @db.Uuid
  resource_id    String   @db.Uuid
  user_id        String   @db.Uuid
  date           DateTime @db.Date
  start_time     DateTime @db.Time
  end_time       DateTime @db.Time

  resource Resource @relation(fields: [resource_id], references: [resource_id], onDelete: Cascade)
  user     Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("reservations")
}
