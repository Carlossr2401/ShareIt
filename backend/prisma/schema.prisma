generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id         String  @id @db.Uuid
  email      String  @unique // Para consultas rápidas desde el backend
  username   String  @unique
  fullName   String? @map("full_name")
  avatarUrl  String? @map("avatar_url")
  bio        String?
  wallet     Float   @default(0)
  role       Role    @default(USER)

  updatedAt  DateTime @updatedAt @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  reservations Reservation[]
  favorites    Favorite[]
  penalties    Penalty[]

  @@map("profiles")
}


model Resource {
  resourceId  String   @id @default(uuid()) @db.Uuid @map("resource_id")
  name        String
  description String?
  location    String?
  photoUrls   String[] @map("photo_urls")
  rules       String[]
  deposit     Float?
  price       Float    @default(0)
  category    String?
  ownerId     String?  @db.Uuid @map("owner_id")

  isArchived  Boolean @default(false) @map("is_archived")

  updatedAt   DateTime @updatedAt @map("updated_at")
  createdAt   DateTime @default(now()) @map("created_at")

  availabilities Availability[]
  reservations   Reservation[]
  favorites      Favorite[]

  @@map("resources")
}

model Availability {
  availabilityId  String   @id @default(uuid()) @db.Uuid @map("availability_id")
  resourceId      String   @db.Uuid @map("resource_id")
  dayOfWeek       Int      @map("day_of_week") // 0 = Sunday, 1 = Monday, etc.
  startTime       DateTime @db.Time @map("start_time")
  endTime         DateTime @db.Time @map("end_time")

  resource Resource @relation(fields: [resourceId], references: [resourceId], onDelete: Cascade)

  @@map("availabilities")
}

model Reservation {
  reservationId String   @id @default(uuid()) @db.Uuid @map("reservation_id")
  resourceId    String   @db.Uuid @map("resource_id")
  userId        String   @db.Uuid @map("user_id")
  date          DateTime @db.Date
  startTime     DateTime @db.Time @map("start_time")
  endTime       DateTime @db.Time @map("end_time")
  
  paymentMethod String   @default("WALLET") @map("payment_method")
  total_price   Float    @default(0) @map("total_amount")

  status        String   @default("PENDING") // Asegúrate de que esta línea esté presente
  createdAt     DateTime @default(now()) @map("created_at") // Asegúrate de que esta línea esté presente
  updatedAt     DateTime @updatedAt @map("updated_at") // Asegúrate de que esta línea esté presente

  resource Resource @relation(fields: [resourceId], references: [resourceId], onDelete: Cascade)
  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model Favorite {
  userId     String   @db.Uuid
  resourceId String   @db.Uuid @map("resource_id")
  user       Profile  @relation(fields: [userId], references: [id])
  resource   Resource @relation(fields: [resourceId], references: [resourceId])

  @@id([userId, resourceId])

  @@map("favorites")
}

model Penalty {
  penaltyId String   @id @default(uuid()) @db.Uuid @map("penalty_id")
  userId    String   @db.Uuid @map("user_id")
  reason    String
  points    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("penalties")
}

enum Role {
  USER
  ADMIN
}
